{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Float",
  "version": "0.2.1",
  "identifier": "fun.gilla.float",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Float",
        "width": 520,
        "height": 560,
        "minWidth": 360,
        "minHeight": 320,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "category": "Productivity",
    "copyright": "Copyright © 2026 Rohith Gilla. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": null
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFMTk4QzJFMDQzOENCRTUKUldUbHl6Z0VMb3daN3BFd0U4WlNXWHhuYTVNMG91S2k1MS9VUkJZaVBrY0tPdjJTTDNPS1owci8K",
      "endpoints": [
        "https://github.com/Rohithgilla12/float/releases/latest/download/latest.json"
      ]
    }
  }
}
